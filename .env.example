# Copy this file to .env and fill in the keys for the providers you want to use.
# Only the key for your chosen --provider is required.

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Mistral AI
MISTRAL_API_KEY=

# Ollama — no key needed, runs locally at http://localhost:11434

# Any OpenAI-compatible endpoint (vLLM, LM Studio, Together AI, etc.)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Optional: set a default provider so you don't need --provider every time
# LLM_PROVIDER=anthropic
